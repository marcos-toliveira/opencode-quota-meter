    "glm-5.3-flash": "GLM 5.3F", "glm-5.3": "GLM 5.3", "glm-5.2": "GLM 5.2",
    "minimax-m3": "MiniMax M3", "minimax-m2.7": "MiniMax 2.7",
    "qwen3.7-plus": "Qwen 3.7+", "qwen3.8-flash": "Qwen 3.8F", "qwen3.8-max": "Qwen 3.8 Max",
