#!/usr/bin/env python3
# quota-meter — medidor de cotas do OpenCode Go por modelo (janelas rolantes 5h/7d/30d).
# Licença: MIT · https://github.com/marcos-toliveira/opencode-quota-meter
#
# Lê o banco local do OpenCode (somente-leitura), resolve o caminho do banco
# automaticamente (`opencode debug paths db`) e ajusta o custo 2x para modelos
# DeepSeek em horário de pico (seg-sex, 01-04h e 06-10h UTC).
#
# Modos: (default) resumo compacto · --line · --details · --json · --tui · --watch N
# Requisitos: Python 3.8+ · OpenCode v2 (para os dados) · curses p/ TUI
#             (Windows: pip install windows-curses).
"""quota-meter — medidor de cotas do OpenCode Go."""

__version__ = "1.0.0"

import argparse
import datetime as dt
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import time

