    "qwen3.7-plus": 60, "qwen3.8-flash": 30, "qwen3.8-max": 15,
    "kimi-k2.7-code": 60, "kimi-k2.6": 60, "kimi-k3": 15,
    "gpt-6-luna": 15, "gpt-5.6-luna": 15, "grok-4.7": 15, "grok-4.6": 15,
    "muse-spark-1.3-contributor": 60, "muse-spark-1.2-contributor": 60,
    "longcat-2.0": 60, "hy3": 60, "hy4-preview": 30,
