def fail(msg):
    print(f"quota-meter: {msg}", file=sys.stderr)
    sys.exit(1)


def resolve_db(explicit=None):
    """--db > QUOTA_METER_DB > `opencode debug paths db` > fallback XDG/Windows."""
    if explicit:
        return os.path.expanduser(explicit)
    env = os.environ.get("QUOTA_METER_DB")
    if env:
        return os.path.expanduser(env)
    exe = shutil.which("opencode")
    if exe:
        try:
            out = subprocess.run([exe, "debug", "paths", "db"],
                                 capture_output=True, text=True, timeout=15)
            for line in reversed((out.stdout or "").strip().splitlines()):
                p = line.strip()
                if p and os.path.isabs(p) and os.path.exists(p):
                    return p
        except Exception:
            pass
    home = os.path.expanduser("~")
    candidates = [
        os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(home, ".local", "share")),
                     "opencode", "opencode.db"),
        os.path.join(os.environ.get("LOCALAPPDATA", ""), "opencode", "opencode.db"),
        os.path.join(os.environ.get("APPDATA", ""), "opencode", "opencode.db"),
    ]
    for c in candidates:
        if c and os.path.exists(c):
            return c
    return candidates[0]


def load_config(path):
    cfg = {}
    if path and os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as f:
                cfg = json.load(f)
        except Exception as e:
            print(f"quota-meter: aviso: config inválido em {path}: {e}", file=sys.stderr)
    return cfg


def is_peak(ms):
    u = dt.datetime.fromtimestamp(ms / 1000, tz=dt.timezone.utc)
    return u.weekday() < 5 and ((1 <= u.hour < 4) or (6 <= u.hour < 10))


def rel_reset(iso):
    """Tempo relativo até um reset (ex.: '1h 03m')."""
    if not iso:
        return ""
    try:
        t = dt.datetime.fromisoformat(iso.replace("Z", "+00:00"))
        secs = (t - dt.datetime.now(dt.timezone.utc)).total_seconds()
    except Exception:
        return ""
    if secs <= 0:
        return "agora"
    d, rem = divmod(int(secs), 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d:
        return f"{d}d {h:02d}h"
    if h:
        return f"{h}h {m:02d}m"
    return f"{m}m"


def official_usage(timeout=8):
    """Métricas oficiais do OpenCode Go via ai-usagebar (se instalado). None se indisponível.

    Env: QUOTA_METER_AUB_CONFIG (config alternativo do ai-usagebar) e
    QUOTA_METER_AUB_CACHE_HOME (isola o cache — necessário para contas diferentes).
    """
    exe = shutil.which("ai-usagebar")
    if not exe:
        return None
    cmd = [exe]
    cfg = os.environ.get("QUOTA_METER_AUB_CONFIG")
    if cfg:
        cmd += ["--config", os.path.expanduser(cfg)]
    cmd += ["usage", "--json"]
    env = dict(os.environ)
    cache_home = os.environ.get("QUOTA_METER_AUB_CACHE_HOME")
    if cache_home:
        env["XDG_CACHE_HOME"] = os.path.expanduser(cache_home)
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
        doc = json.loads(out.stdout or "{}")
    except Exception:
        return None
    for e in doc.get("entries") or []:
        if e.get("brand") != "opencode-go" or e.get("status") != "ready" or e.get("error"):
            continue
        metrics = {}
        for m in e.get("metrics") or []:
            label = (m.get("label") or "").lower()
            key = "5h" if ("rolling" in label or "5h" in label) else (
                "7d" if ("weekly" in label or "7d" in label) else (
                    "30d" if "monthly" in label else None))
            if key:
                metrics[key] = {"pct": m.get("percent"), "reset_at": m.get("reset_at"),
                                "severity": m.get("severity")}
        if metrics:
            metrics["fetched_at"] = e.get("fetched_at")
            metrics["starts"] = _window_starts(metrics)
            return metrics
    return None


def _window_starts(metrics):
    """Deriva o início das janelas oficiais a partir dos resets (7d e mês/billing)."""
    starts = {}
    def _parse(v):
        return dt.datetime.fromisoformat((v or "").replace("Z", "+00:00"))
    try:
        r7 = _parse((metrics.get("7d") or {}).get("reset_at"))
        starts["7d"] = (r7 - dt.timedelta(days=7)).isoformat()
    except Exception:
        pass
    try:
        r30 = _parse((metrics.get("30d") or {}).get("reset_at"))
        y, m = r30.year, r30.month - 1
        if m == 0:
            y, m = y - 1, 12
        starts["30d"] = r30.replace(year=y, month=m).isoformat()
    except Exception:
        pass
    return starts


def open_db(db):
    if not os.path.exists(db):
        fail(f"banco do OpenCode não encontrado em {db}\n"
             "  → instale/use o OpenCode v2, ou aponte com --db / QUOTA_METER_DB.")
    try:
        con = sqlite3.connect("file:" + db + "?mode=ro", uri=True)
        tables = {r[0] for r in con.execute("select name from sqlite_master where type='table'")}
    except sqlite3.Error as e:
        fail(f"não consegui abrir o banco {db}: {e}")
    if "session_message" not in tables:
        fail(f"schema do OpenCode v2 não encontrado em {db} "
             "(tabela session_message ausente). Versão incompatível?")
    return con


def load(db, limits, peak_doubled, short, flat=False, starts=None):
    now_ms = int(time.time() * 1000)
    bounds = {}
    for (w, span, _) in WINDOWS:
        start_ms = None
        if starts and starts.get(w):
            try:
                start_ms = int(dt.datetime.fromisoformat(starts[w]).timestamp() * 1000)
            except Exception:
                start_ms = None
        bounds[w] = start_ms if start_ms is not None else now_ms - span
    agg = {}
    con = open_db(db)
    for (tc, data) in con.execute(
        "select time_created, data from session_message "
        "where type='assistant' and time_created >= ?",
        (now_ms - WINDOWS[-1][1],),
    ):
        try:
            d = json.loads(data)
        except Exception:
            continue
        mid = (d.get("model") or {}).get("id")
        if not mid:
            continue
        ts = (d.get("time") or {}).get("created") or tc
        cost = d.get("cost") or 0.0
        if not flat and mid in peak_doubled and is_peak(ts):
            cost *= 2
        a = agg.setdefault(mid, {"w": [0.0, 0.0, 0.0], "n": [0, 0, 0]})
        for i, (w, span, _) in enumerate(WINDOWS):
            if bounds[w] <= ts <= now_ms:
                a["w"][i] += cost
                a["n"][i] += 1

    models = []
    for mid, a in agg.items():
        limit = limits.get(mid)
        caps = [limit * f for (_, _, f) in WINDOWS] if limit else [None] * 3
        pcts = [(a["w"][i] / caps[i] * 100 if caps[i] else 0.0) for i in range(3)]
        worst = max(pcts) if limit else 0.0
        if limit is None:
            status = "livre"
        elif worst >= 100:
            status = "estourado"
        elif worst >= 90:
            status = "critico"
        elif worst >= 70:
            status = "atencao"
        else:
            status = "ok"
        models.append({
            "id": mid, "name": short.get(mid, mid[:14]), "limit": limit,
            "used": a["w"], "caps": caps, "pct": pcts, "reqs": a["n"],
            "worst": worst, "status": status,
        })
    models.sort(key=lambda m: -m["worst"])
    return models, now_ms


def usd(x):
    return f"${x:,.2f}" if abs(x) >= 1 else f"${x:.3f}"


def color_for(pct):
    return GREEN if pct < 70 else (YELLOW if pct < 90 else RED)


def bar(pct, width=8, use_color=True):
    filled = int(round(min(max(pct, 0), 100) / 100 * width))
    s = "█" * filled + "░" * (width - filled)
    return f"{color_for(pct)}{s}{RESET}" if use_color else s


def flag(m):
    return {"estourado": " ⚠", "critico": " ⚠", "atencao": " ~"}.get(m["status"], "")


def fmt_pretty(models, now_ms, size=8, use_color=True):
    if not models:
        return "OC Go: sem uso nos últimos 30 dias"
    hh = dt.datetime.fromtimestamp(now_ms / 1000)
    head = f"OC Go · {hh:%d/%m %H:%M}"
    lines = [f"{CYAN}{head}{RESET}" if use_color else head]
    for m in models[:6]:
        if m["limit"]:
            cells = "  ".join(
                f"{w} {bar(m['pct'][i], size, use_color)} {m['pct'][i]:>4.0f}%"
                for i, (w, _, _) in enumerate(WINDOWS)
            )
        else:
            cells = "ilimitado"
        lines.append(f"{m['name']:<13} {cells}{flag(m)}")
    return "\n".join(lines)


def fmt_line(models):
    if not models:
        return "OC Go: sem uso"
    top = max(models, key=lambda m: m["pct"][1])
    return (f"OC Go ⟫ 5h máx {max(m['pct'][0] for m in models):.0f}% · "
            f"7d máx {top['pct'][1]:.0f}% ({top['name']}){flag(top)} · "
            f"30d máx {max(m['pct'][2] for m in models):.0f}%")


def fmt_tclock(models, official=None, use_color=True):
    """Tabela numérica compacta para o widget do tclock (%, por janela/modelo)."""
    lines = []
    if official:
        parts = []
        for w in ("5h", "7d", "30d"):
            o = official.get(w) or {}
            if o.get("pct") is not None:
                c = color_for(o["pct"]) if use_color else ""
                rst = RESET if use_color else ""
                parts.append(f"{w} {c}{o['pct']:>3.0f}%{rst}")
        if parts:
            lines.append("Oficial  " + " · ".join(parts))
    if models:
        lines.append("Modelo" + "".join(f"{w:>7}" for w in ("5h", "7d", "30d")))
        for m in models[:6]:
            if not m["limit"]:
                lines.append(f"{m['name']:<14} ilimitado")
                continue
            cells = []
            for i in range(3):
                pct = m["pct"][i]
                fl = "⚠" if pct >= 90 else ("~" if pct >= 70 else "")
                pad = f"{pct:>4.0f}%{fl}".ljust(7)
                if use_color:
                    pad = f"{color_for(pct)}{pad}{RESET}"
                cells.append(pad)
            lines.append(f"{m['name']:<14}" + "".join(cells).rstrip())
    if not lines:
        lines.append("OC Go: sem uso nos últimos 30 dias")
    return "\n".join(lines)


def fmt_details(models, now_ms, official=None):
    hh = dt.datetime.fromtimestamp(now_ms / 1000)
    out = [f"OpenCode Go — quotas por modelo (5h/7d/30d) · {hh:%d/%m/%Y %H:%M}"]
    if official:
        parts = []
        for w in ("5h", "7d", "30d"):
            o = official.get(w) or {}
            if o.get("pct") is not None:
                r = rel_reset(o.get("reset_at"))
                parts.append(f"{w} {o['pct']:.0f}%" + (f" (reseta {r})" if r else ""))
        if parts:
            out.append("Oficial (ai-usagebar): " + " · ".join(parts))
    out.append(f"{'Modelo':<16}{'Lim':>6}  {'5h':>19}  {'7d':>19}  {'30d':>19}  {'Reqs':>6}  Status")
    for m in models:
        if not m["limit"]:
            out.append(f"{m['name']:<16}{'∞':>6}  {'—':>19}  {'—':>19}  {'—':>19}  {m['reqs'][2]:>6}  livre")
            continue
        cells = [f"{usd(m['used'][i])}/{usd(m['caps'][i])} {m['pct'][i]:>3.0f}%" for i in range(3)]
        out.append(
            f"{m['name']:<16}{usd(m['limit']):>6}  {cells[0]:>19}  {cells[1]:>19}  {cells[2]:>19}  {m['reqs'][2]:>6}  {m['status']}"
        )
    return "\n".join(out)


def fmt_json(models, now_ms, flat, official=None, indent=None):
    return json.dumps({
        "generated_at": dt.datetime.fromtimestamp(now_ms / 1000).isoformat(timespec="seconds"),
        "peak_adjusted": not flat,
        "official": official,
        "models": [
            {
                "id": m["id"], "name": m["name"], "limit_usd": m["limit"],
                "windows": {
                    w: {"used_usd": round(m["used"][i], 4), "cap_usd": m["caps"][i],
                        "pct": round(m["pct"][i], 1), "requests": m["reqs"][i]}
                    for i, (w, _, _) in enumerate(WINDOWS)
                },
                "status": m["status"],
            } for m in models
        ],
    }, ensure_ascii=False, indent=indent)


def run_tui(db, limits, peak_doubled, short, official_enabled=True):
    try:
        import curses
    except ImportError:
        fail("TUI requer o módulo curses (no Windows: pip install windows-curses).\n"
             "  → use --line / --details / --json, ou rode no WSL.")

    def main(stdscr):
        curses.curs_set(0)
        stdscr.timeout(1000)
        try:
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_GREEN, -1)
            curses.init_pair(2, curses.COLOR_YELLOW, -1)
            curses.init_pair(3, curses.COLOR_RED, -1)
        except curses.error:
            pass
        state = {"flat": False, "last": 0.0, "official": None, "official_last": 0.0}

        def draw():
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            starts = (state.get("official") or {}).get("starts")
            models, now_ms = load(db, limits, peak_doubled, short, flat=state["flat"], starts=starts)
            hh = dt.datetime.fromtimestamp(now_ms / 1000)
            title = (f" quota-meter {__version__} — OpenCode Go · {hh:%d/%m %H:%M:%S} "
                     f"· pico {'OFF' if state['flat'] else 'ON'} ")
            try:
                stdscr.addstr(0, 0, title[: w - 1], curses.A_REVERSE)
            except curses.error:
                pass
            if state.get("official"):
                o = state["official"]
                parts = []
                for wd in ("5h", "7d", "30d"):
                    oo = o.get(wd) or {}
                    if oo.get("pct") is not None:
                        r = rel_reset(oo.get("reset_at"))
                        parts.append(f"{wd} {oo['pct']:.0f}%" + (f" r:{r}" if r else ""))
                try:
                    stdscr.addstr(1, 1, ("Oficial (ai-usagebar): " + " · ".join(parts))[: w - 2])
                except curses.error:
                    pass

            mode = "full" if w >= 118 else ("mid" if w >= 94 else "tiny")
            cellw = {"full": 20, "mid": 14, "tiny": 6}[mode]
            namew = 15 if mode != "tiny" else 13

            def usage_cell(m, idx):
                pct = m["pct"][idx]
                pair = 1 if pct < 70 else (2 if pct < 90 else 3)
                if mode == "full":
                    txt = f"{usd(m['used'][idx])}/{usd(m['caps'][idx])} {pct:>3.0f}%"
                elif mode == "mid":
                    txt = f"{usd(m['used'][idx])} {pct:>3.0f}%"
                else:
                    txt = f"{pct:>3.0f}%"
                return txt.ljust(cellw), pair

            head = f"{'Modelo':<{namew}}"
            if mode == "full":
                head += f"{'Lim':>7}"
            head += "  " + "  ".join(f"{wd:<{cellw}}" for wd, _, _ in WINDOWS)
            head += f" {'Reqs':>6}  Status"
            try:
                stdscr.addstr(2, 1, head[: w - 2], curses.A_BOLD)
            except curses.error:
                pass

            r = 3
            for m in models:
                if r >= h - 3:
                    break
                try:
                    x = 1
                    stdscr.addstr(r, x, f"{m['name']:<{namew}}"[:namew])
                    x += namew
                    if mode == "full":
                        lim = usd(m["limit"]) if m["limit"] else "∞"
                        stdscr.addstr(r, x, f"{lim:>7}")
                        x += 7
                    x += 2
                    if m["limit"]:
                        for idx in range(3):
                            txt, pair = usage_cell(m, idx)
                            if x + cellw <= w - 2:
                                stdscr.addstr(r, x, txt, curses.color_pair(pair))
                            x += cellw + 2
                    else:
                        txt = f"ilimitado ({m['reqs'][2]} reqs) "
                        if x + len(txt) < w - 2:
                            stdscr.addstr(r, x, txt[: w - x - 2])
                        x += len(txt)
                    tail = f"{m['reqs'][2]:>6}  {m['status']}{flag(m)}"
                    if x + len(tail) <= w - 2:
                        if m["status"] in ("ok", "livre"):
                            attr = curses.color_pair(1)
                        else:
                            pair = 2 if m["status"] == "atencao" else 3
                            attr = curses.color_pair(pair) | curses.A_BOLD
                        stdscr.addstr(r, x, tail, attr)
                except curses.error:
                    pass
                r += 1
            if r == 3:
                try:
                    stdscr.addstr(3, 1, "Sem uso registrado nos últimos 30 dias.")
                except curses.error:
                    pass
            try:
                stdscr.addstr(h - 1, 0, " q sair · r atualizar · a ajuste de pico · auto 60s "[: w - 1], curses.A_DIM)
            except curses.error:
                pass
            stdscr.refresh()

        while True:
            now = time.time()
            if official_enabled and now - state["official_last"] >= 300:
                state["official"] = official_usage()
                state["official_last"] = now
            if now - state["last"] >= 60:
                draw()
                state["last"] = now
            ch = stdscr.getch()
            if ch == ord("q"):
                break
            if ch in (ord("r"), curses.KEY_RESIZE):
                draw()
                state["last"] = time.time()
            elif ch == ord("a"):
                state["flat"] = not state["flat"]
                draw()
                state["last"] = time.time()

    curses.wrapper(main)


def main():
    ap = argparse.ArgumentParser(
        prog="quota-meter",
        description="Medidor de cotas do OpenCode Go por modelo (janelas rolantes 5h/7d/30d).",
    )
    ap.add_argument("--line", action="store_true", help="resumo em uma linha")
    ap.add_argument("--details", action="store_true", help="tabela completa")
    ap.add_argument("--json", action="store_true", help="saída JSON")
    ap.add_argument("--tui", action="store_true", help="interface interativa (curses)")
    ap.add_argument("--watch", type=int, default=0, metavar="N", help="repete a cada N segundos")
    ap.add_argument("--flat", action="store_true", help="não ajusta custo de pico")
    ap.add_argument("--bar", type=int, default=8, help="largura das barras (default 8)")
    ap.add_argument("--no-color", action="store_true", help="sem cores ANSI")
    ap.add_argument("--indent", type=int, default=None, help="indentação do JSON")
    ap.add_argument("--db", default=None, help="caminho do opencode.db")
    ap.add_argument("--config", default=CONFIG_DEFAULT, help="arquivo de configuração JSON")
    ap.add_argument("--tclock", action="store_true", help="formato compacto p/ widget do tclock (inclui oficiais)")
    ap.add_argument("--official", action="store_true", help="força leitura das métricas oficiais (ai-usagebar)")
    ap.add_argument("--no-official", action="store_true", help="não consultar o ai-usagebar")
    ap.add_argument("-V", "--version", action="version", version=f"quota-meter {__version__}")
    args = ap.parse_args()

    db = resolve_db(args.db)
    cfg = load_config(args.config)
    limits = dict(LIMITS)
    limits.update(cfg.get("limits") or {})
    short = dict(SHORT)
    short.update(cfg.get("short_names") or {})
    peak_doubled = set(cfg.get("peak_doubled") or PEAK_DOUBLED)

    if args.tui:
        run_tui(db, limits, peak_doubled, short, official_enabled=use_official)
        return

    use_official = (not args.no_official) and (args.official or args.tclock or args.details or args.tui)
    use_color = ((not args.no_color) and "NO_COLOR" not in os.environ
                 and (sys.stdout.isatty() or "TCLOCK_WIDGET_THEME" in os.environ))

    def render():
        official = official_usage() if use_official else None
        starts = official.get("starts") if official else None
        models, now_ms = load(db, limits, peak_doubled, short, flat=args.flat, starts=starts)
        if args.tclock:
            return fmt_tclock(models, official, use_color)
        if args.json:
            return fmt_json(models, now_ms, args.flat, official, args.indent)
        if args.line:
            return fmt_line(models)
        if args.details:
            return fmt_details(models, now_ms, official)
        return fmt_pretty(models, now_ms, args.bar, use_color)

    if args.watch > 0:
        try:
            while True:
                print(render())
                sys.stdout.flush()
                time.sleep(args.watch)
        except KeyboardInterrupt:
            pass
    else:
        print(render())


if __name__ == "__main__":
    main()
